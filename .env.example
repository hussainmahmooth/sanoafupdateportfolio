# Local defaults. Configure these as environment variables on your host.
# This file is an example; npm start does not load it automatically.
HOST=127.0.0.1
PORT=3000
COOKIE_SECURE=false

# Production: HOST=0.0.0.0, COOKIE_SECURE=true, and an absolute persistent path.
# PORTFOLIO_DATA_DIR=/var/data/chef-portfolio

# Optional first-run initialization. Set a private password of 12+ characters
# in your host's secret settings, then remove it after setup. Never commit it.
# PORTFOLIO_OWNER_PASSWORD=
